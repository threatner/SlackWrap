Screen { background: $surface; }
#search-title { text-align: center; text-style: bold; padding: 1 0; }
#search-input { width: 60%; margin: 1 0; }
#search-results { width: 80%; height: 1fr; margin: 1 0; }
#dashboard-header { height: 3; dock: top; padding: 0 2; background: $primary-background; }
#stats-grid { padding: 1 2; height: auto; }
.stat-card { height: 7; padding: 1 2; background: $panel; border: round $primary; }
#sparkline-container { height: 5; padding: 0 2; margin: 1 0; }
#keybind-bar { dock: bottom; height: 1; background: $primary-background; padding: 0 2; }
#sync-container { align: center middle; width: 60%; height: auto; padding: 2; }
#sync-status { text-align: center; padding: 1; }
#chat-log { height: 1fr; overflow-y: auto; padding: 1; border: round $primary; }
#chat-input { dock: bottom; height: 3; margin: 1 0; }
